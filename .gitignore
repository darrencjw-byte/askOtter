# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-buildcheck/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
/generated

# python / streamlit
.venv/
__pycache__/
*.py[cod]
.streamlit/secrets.toml

# RAG document store & vector index (local, regenerated per deployment)
.rag_data/

# Next.js files (disabled - using Streamlit instead)
package.json.backup
package-lock.json.backup
/node_modules

# VIBER Studio internal files (never commit these)
.deps-hash
.viber-prepared
.viber-vite.config.mjs
*.viber-bak
package-lock.json
